# Copy to .env and fill in. Never commit .env.

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# The first admin account, created on startup if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Where the shop's front end runs, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# VietQR bank transfer. Bank id is the bank's BIN or short name, e.g. 970436 or VCB.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
